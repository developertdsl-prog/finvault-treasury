{
  "name": "finvault-treasury",
  "version": "1.0.0",
  "description": "Global Corporate Treasury Management System, Multi-Currency Liquidity Pooling, Real-Time Cash Concentration & FX Hedging Engine",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "npm start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "node server/utils/seedTreasury.js",
    "test": "jest --detectOpenHandles --runInBand",
    "lint": "eslint server/**/*.js client/src/**/*.{js,jsx}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/developertdsl-prog/finvault-treasury.git"
  },
  "keywords": [
    "treasury-management",
    "liquidity-pooling",
    "cash-concentration",
    "fx-hedging",
    "iso20022",
    "swift-payments",
    "fintech",
    "corporate-finance"
  ],
  "author": "developertdsl-prog <developer.tdsl@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "winston": "^3.13.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.2",
    "supertest": "^7.0.0"
  }
}
