REDIS_URL=redis://localhost:6379

# Corporate Treasury Parameters
BASE_CURRENCY=USD
MAX_SINGLE_WIRE_LIMIT_USD=50000000
AUTO_SWEEP_TOLERANCE_THRESHOLD=50000

# Security & Compliance
TREASURY_API_KEY=finvault_sec_live_prod_key_7719
SWIFT_NETWORK_GATEWAY_URL=https://mock-swift.finvault.internal/iso20022
SANCTIONS_AML_STRICT_MODE=true

# Logging
LOG_LEVEL=info
